{
  "name": "fieldops",
  "version": "1.0.0",
  "private": true,
  "description": "Admin web console + Android employee app for site tanker and DG hour readings",
  "scripts": {
    "deploy": "wrangler pages deploy public",
    "db:schema": "wrangler d1 execute fieldops --remote --file=./schema.sql",
    "db:users": "wrangler d1 execute fieldops --remote --file=./seed-users.sql",
    "users": "node scripts/create-users.mjs 25 0",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "wrangler": "^3.90.0"
  }
}
