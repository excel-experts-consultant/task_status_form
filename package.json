{
  "name": "fieldops",
  "version": "2.0.0",
  "private": true,
  "description": "Admin web console + Android employee app for site tanker and DG hour readings",
  "scripts": {
    "deploy": "wrangler pages deploy public --project-name fieldops --branch fieldops --commit-dirty=true",
    "db:reset": "wrangler d1 execute fieldops --remote --file=schema.sql -y",
    "db:users": "wrangler d1 execute fieldops --remote --file=private/seed-users.sql -y",
    "db:sample": "wrangler d1 execute fieldops --remote --file=sample-sites.sql -y",
    "users": "node scripts/create-users.mjs 25 5"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "wrangler": "^3.90.0"
  }
}
